{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dataverse Access role API",
    "version": "6.9"
  },
  "items": [
    {
      "info": {
        "name": "role",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lists all assignable roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dataverse.nl/roles"
          },
          "docs": "Lists all assignable roles that are currently available"
        },
        {
          "info": {
            "name": "Returns an assignable role",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dataverse.nl/roles/:assignableRoleName",
            "params": [
              {
                "name": "assignableRoleName",
                "value": "",
                "type": "path",
                "description": "Get assignable role from assignable role name."
              }
            ]
          },
          "docs": "Returns an assignable role if it is currently available"
        }
      ]
    }
  ],
  "bundled": true
}