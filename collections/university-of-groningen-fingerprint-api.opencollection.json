{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dataverse Access fingerprint API",
    "version": "6.9"
  },
  "items": [
    {
      "info": {
        "name": "fingerprint",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lists all fingerprints",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dataverse.nl/fingerprints",
            "params": [
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of returned fingerprints per request."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The offset for the returned list. 0 or null value is from the start"
              }
            ]
          },
          "docs": "Lists all fingerprints in the Pure instance. If you need to filter the fingerprints returned, see the POST version which supports additional filtering."
        },
        {
          "info": {
            "name": "Query operation for fingerprints",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://dataverse.nl/fingerprints/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Lists fingerprints in the Pure instance that matches the provided query, similar to the GET version, instead of using parameters to alter the response, a JSON document is posted with the request. The JSON document contains fields for all the parameters available for the GET version, but also additional filtering options."
        },
        {
          "info": {
            "name": "Get fingerprint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dataverse.nl/fingerprints/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "UUID of the desired fingerprint"
              }
            ]
          },
          "docs": "Get fingerprint with specific UUID."
        }
      ]
    }
  ],
  "bundled": true
}